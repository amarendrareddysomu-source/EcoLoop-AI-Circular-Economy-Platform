# Environment Template for AI-Powered Circular Economy Action Decision Support Platform

PROJECT_NAME="AI-Powered Circular Economy Platform"
ENVIRONMENT="production" # development, testing, production
DEBUG=false
PORT=8000

# Security & Authentication
SECRET_KEY="replace-with-secure-random-64-character-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/circular_economy"

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["https://circulareconomy.example.com","http://localhost:5173"]

# Storage & Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=5

# Frontend Configuration
VITE_API_URL="https://circulareconomy.example.com/api/v1"
